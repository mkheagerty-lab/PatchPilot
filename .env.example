# ============================================================================
# PatchPilot environment configuration
# Copy to .env and lock down file permissions (chmod 600 / restrict ACL).
# The browser NEVER sees any of these secrets. All tokens stay server-side.
# ============================================================================

# ---- Public host / routing ----
# The public HTTPS origin where PatchPilot is reached. Caddy provisions TLS.
PUBLIC_URL=https://patchpilot.example.com
# Bare hostname Caddy serves + requests a Let's Encrypt cert for.
PP_DOMAIN=patchpilot.example.com
# Entra app redirect URI (must EXACTLY match the app registration):
#   https://patchpilot.<msp-domain>.com/auth/callback
AUTH_REDIRECT_URI=https://patchpilot.example.com/auth/callback

# ---- Entra ID / MSAL (MSP tenant) ----
# From Deploy-PatchPilot.ps1 output. Left BLANK on purpose: config.ts treats
# "all three set" vs "all three blank" as the only two valid states in
# production (ENTRA_CONFIGURED), and a fresh instance is meant to boot with
# none of them and serve the "Pair this instance" setup screen until the
# phone-home pairing flow supplies real values. A non-empty placeholder here
# (even an obviously-fake one) makes ENTRA_CONFIGURED true and sends the
# browser into a real Microsoft login attempt against garbage credentials —
# this is exactly what broke the first live Azure test deploy.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Delegated scope the app exposes on itself ("Expose an API" in the portal — see
# README). Requested at login so the session token's audience is PatchPilot, used
# only as the OBO assertion. Leave unset to default to api://<client-id>/access_as_user.
# ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# ---- Session / crypto ----
# 32-byte base64 keys. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-byte-base64
TOKEN_ENCRYPTION_KEY=replace-me-with-32-byte-base64

# ---- Database (PostgreSQL) ----
POSTGRES_USER=patchpilot
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=patchpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://patchpilot:replace-me@postgres:5432/patchpilot

# ---- Redis (BullMQ + token cache backing) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- API ----
API_PORT=4000
# Comma-separated origins allowed to call the API (the web app origin).
CORS_ORIGINS=https://patchpilot.example.com
# Background auto-sync cadence (minutes) for reachable customer tenants: the API
# periodically refreshes devices + vulnerabilities with no engineer clicking
# "Sync Data", using each logged-in engineer's cached delegated credentials. Set
# to 0 to disable. Ignored in DEMO_MODE (the loop never starts).
AUTO_SYNC_INTERVAL_MINUTES=60

# ---- Self-update (Settings -> Updates) --------------------------------------
# How often the API polls GitHub Releases for a newer PatchPilot version. Set
# to 0 to disable. NOT ignored in DEMO_MODE (a harmless public read, and worth
# showing in a demo).
# UPDATE_CHECK_INTERVAL_HOURS=6
# Override only for local testing against a stub JSON server instead of the
# real, unauthenticated GitHub Releases API.
# GITHUB_RELEASES_URL=https://api.github.com/repos/mkheagerty-lab/PatchPilot/releases/latest

# ---- Users & roles ----
# A person must have an active row in Settings -> Users before Entra login is
# honoured — GDAP alone is not enough. This UPN is seeded/promoted to an
# active admin on every startup, so it's both how you provision the very
# first admin and how you recover from locking yourself out (set it, restart,
# sign in). Safe to leave set permanently; the upsert is idempotent.
# BOOTSTRAP_ADMIN_UPN=you@yourmsp.com

# ---- Feature flags ----
# DEMO_MODE=true (the default) runs with ZERO dependencies: auth is bypassed with
# a demo engineer and all data is served from in-memory fixtures — none of the
# secrets, DATABASE_URL, or REDIS_URL above are required, and you don't even need
# this .env file to run `pnpm dev`. Set DEMO_MODE=false for production, which then
# REQUIRES every secret/URL above to be set for real (demo placeholders rejected).
DEMO_MODE=true
LOG_LEVEL=info

# ---- AI features (summaries, reports, chatbot) ----
# Off by default: opt in rather than have a fresh deploy silently stand up a
# multi-GB local-LLM container. The model runs self-hosted (Ollama, see
# infra/docker-compose.yml) — no data ever leaves this stack, no internet
# access at inference time. See README "AI features" for the one-time model
# pull step required after first `docker compose up -d`.
AI_FEATURES_ENABLED=false
# Compose service name in prod; only relevant to override for host `pnpm dev`
# (defaults to the dev compose file's published port, localhost:11434).
# OLLAMA_BASE_URL=http://ollama:11434
# Meta (USA), Llama Community License, Ollama-native tool calling. US/AU
# vendor-trust requirement rules out PRC-origin models (e.g. Qwen). Use
# llama3.1:70b on beefier hardware for higher quality.
# OLLAMA_MODEL=llama3.1:8b

# --- Reports (branded PDF generation) ----------------------------------------
# Reports themselves need no configuration: with everything below left at its
# default, an engineer with operations:read can generate a full PDF. AI
# narration is the only part gated by AI_FEATURES_ENABLED above, and a report
# generates fine without it.
#
# Kill switch for PDF RENDERING only. With this false the worker still drains
# the queue and marks each report failed with a clear reason, rather than
# leaving rows stuck at "pending" on a box that cannot run Chromium.
# REPORT_PDF_ENABLED=true
# Where Chromium is. Set by infra/Dockerfile.worker to the apk-installed
# binary; leave unset on a host that has Playwright resolve its own.
# REPORT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# ON A WINDOWS DEV BOX, SET THIS. It drives the already-installed Edge, so
# there is nothing to download to work on reports locally. Leave empty in
# every container — a channel takes precedence over an executable path.
# REPORT_BROWSER_CHANNEL=msedge
# Bound on page.pdf() alone; the whole-job backstop above it guarantees a row
# always reaches a terminal status.
# REPORT_PDF_TIMEOUT_MS=60000
# REPORT_JOB_TIMEOUT_MS=300000
# One render at a time: Chromium peaks at 250-400 MB and narration is already
# serialized behind a single-model Ollama.
# REPORT_CONCURRENCY=1
# Ceiling on a stored PDF. A branded 8-page report is 150-600 KB, so this only
# fires on a runaway render. Read by BOTH the api and the worker — change both
# or neither.
# REPORT_MAX_BYTES=26214400
# How long a report is kept. Stamped onto reports.expires_at at INSERT and
# never recomputed, so lowering it affects future reports only. Also read by
# both the api and the worker.
# REPORT_RETENTION_DAYS=90
# Per-engineer cap, oldest deleted first after each successful render.
# REPORT_RETENTION_MAX_PER_ENGINEER=50

# ---- Failure alerting (email) ------------------------------------------------
# Superseded by the in-app Settings > Notifications page (admin-configurable
# SMTP relay, stored in the `settings` table) plus the per-user opt-in on
# Settings > Users — that UI is what most deployments should use. The vars
# below are only a fallback: packages/shared/src/alerting.ts falls back to
# them when no app has called configureAlerting() (e.g. package-local unit
# tests), and are otherwise unused once the in-app settings are configured.
# Leave SMTP_HOST unset to disable alerting entirely (the default): job/sync
# failures, uncaught exceptions, and unexpected 5xx errors are then only visible
# in the audit log and process logs, same as today. No third-party dashboard —
# plain SMTP, so any relay (a Microsoft 365 shared mailbox, SendGrid SMTP, a
# local Postfix relay, etc.) works.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=replace-me
# SMTP_SECURE=false
# SMTP_FROM=PatchPilot Alerts <alerts@example.com>
# Comma-separated recipient list.
# ALERT_EMAIL_TO=oncall@example.com

# ---- Postgres backups (local disk, no cloud/offsite by design) --------------
# The `backup` compose service runs pg_dump nightly (02:00 container time) to
# ./backups/ at the repo root (bind-mounted, NOT a Docker named volume, so it's
# a plain directory on the host disk an admin can copy/inspect directly).
# apps/worker alerts (see apps/worker/src/backup-watchdog.ts) if a nightly run
# is ever missing or fails, via the SMTP settings above.
# How many days of dumps to keep before the oldest are deleted.
# BACKUP_RETENTION_DAYS=14
# Hour (0-23, container-local time) the nightly dump runs at.
# BACKUP_HOUR=2
