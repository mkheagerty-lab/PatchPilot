# PatchPilot API (Fastify). Built from the monorepo root context.
# Phase 1 runs TypeScript directly via tsx so workspace packages that export
# .ts source resolve cleanly. A pruned compiled image is a later optimisation.
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app

# Copy manifests first for layer caching.
COPY pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY apps/api/package.json apps/api/

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile=false --filter @patchpilot/api...

# Copy sources.
COPY packages/shared packages/shared
COPY packages/db packages/db
COPY apps/api apps/api

EXPOSE 4000
WORKDIR /app/apps/api
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
