{
  "name": "@patchpilot/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:resilient": "node ../../scripts/run-resilient.mjs pnpm exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/session": "^11.0.2",
    "@patchpilot/ai": "workspace:*",
    "@patchpilot/db": "workspace:*",
    "@patchpilot/graph": "workspace:*",
    "@patchpilot/shared": "workspace:*",
    "bullmq": "^5.34.5",
    "drizzle-orm": "^0.38.3",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.2.0",
    "fflate": "^0.8.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "postgres": "^3.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
